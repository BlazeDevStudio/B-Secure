{
  "manifest_version": 3,
  "name": "B Secure",
  "short_name": "B Secure",
  "version": "11.5.0",
  "description": "B Secure local Chrome lock with low-memory tab recovery and configurable failed-attempt protections. By L.C.Manreal.",
  "icons": {
    "16": "assets/bsecure-z-16.png",
    "32": "assets/bsecure-z-32.png",
    "48": "assets/bsecure-z-48.png",
    "128": "assets/bsecure-z-128.png"
  },
  "action": {
    "default_title": "B Secure — Quick controls",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/bsecure-z-16.png",
      "32": "assets/bsecure-z-32.png",
      "48": "assets/bsecure-z-48.png",
      "128": "assets/bsecure-z-128.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "102",
  "author": "L.C.Manreal"
}
